# nginx site for the English site, serving the build output (dist/).
# Copy to /etc/nginx/sites-available/vngt-ib, adjust the domain and paths,
# link it into sites-enabled, then: nginx -t && systemctl reload nginx
#
# Before HTTPS works the certificate must exist. The challenge files get their own
# folder because the hourly build replaces dist/:
#   mkdir -p /var/www/acme
#   certbot certonly --webroot -w /var/www/acme -d vngrouptourist.com -d www.vngrouptourist.com \
#     --deploy-hook "systemctl reload nginx"
# This is the config running on 103.90.227.39.

# Cache rules: photos and versioned CSS/JS rarely change, pages always revalidate.
map $uri $vngt_ib_cache {
    ~^/img/            "public, max-age=2592000, immutable";
    ~^/assets/         "public, max-age=604800";
    default            "no-cache";
}

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name vngrouptourist.com www.vngrouptourist.com _;

    # certbot renewals
    location ^~ /.well-known/acme-challenge/ { root /var/www/acme; }
    location / { return 301 https://vngrouptourist.com$request_uri; }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name www.vngrouptourist.com;
    ssl_certificate     /etc/letsencrypt/live/vngrouptourist.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/vngrouptourist.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    return 301 https://vngrouptourist.com$request_uri;
}

server {
    listen 443 ssl http2 default_server;
    listen [::]:443 ssl http2 default_server;
    server_name vngrouptourist.com;
    ssl_certificate     /etc/letsencrypt/live/vngrouptourist.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/vngrouptourist.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    root /code/vngt-ib/dist;
    index index.html;
    error_page 404 /404.html;

    gzip on;
    gzip_vary on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json image/svg+xml text/xml text/plain;

    # One place for headers: add_header inside a location would drop these.
    add_header Cache-Control $vngt_ib_cache always;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    location / {
        try_files $uri $uri/ =404;
    }
}
